GEMINI_API_KEY=

# API tìm kiếm hồ sơ vay (chỉ dùng phía server, không lộ ra trình duyệt)
# Local: .env | Vercel: Project Settings → Environment Variables
API_BASE_URL=https://your-api-domain.com
API_LOGIN=xxxxxxxxxxx

# API tạo PDF phiếu thu (loanlook gọi với header x-api-key)
# POST https://your-receipt-host/api/slips/generate
SLIP_API_KEY=change-me-long-random-secret
