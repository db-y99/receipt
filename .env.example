GEMINI_API_KEY=

# Data API (chỉ dùng phía server, không lộ ra trình duyệt)
# Local: .env | Vercel: Project Settings → Environment Variables
# API_LOGIN chỉ cho POST /api/slips/generate. Trang web dùng cookie user_id sau đăng nhập.
API_BASE_URL=https://your-api-domain.com
API_LOGIN=xxxxxxxxxxx

# Phân quyền: bảng profiles (cùng project Supabase với LoanLook).
# Chỉ dùng trên server. Không thêm prefix VITE_ — key không được vào bundle trình duyệt.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# API tạo PDF phiếu thu (loanlook gọi với header x-api-key)
# POST https://your-receipt-host/api/slips/generate
SLIP_API_KEY=change-me-long-random-secret
